# D636: x86-64 lazy stubs no section states are unnamed, so `__libc_start_main`'s handed `main` is
# unread; radare2 and `nm` of the undamaged crackme place `main` at 0x4006a4.
NAME=a refused section table still reaches main through __libc_start_main
FILE=tests/fixtures/crackme_shoff_past_end
CMDS=afl~0x004006a4
BROKEN=1
EXPECT=<<EOF
0x004006a4    4    127 fcn.004006a4
EOF
RUN
