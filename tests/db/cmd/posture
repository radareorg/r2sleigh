# How an image is linked and protected, under radare2's keys (`i`), and the libraries it needs (`il`).

# A dynamic executable names its interpreter, binds at load and seals its relocations.
NAME=dynamic executable
FILE=tests/fixtures/rv_O0g
CMDS=i~^intrp; i~^nx; i~^pic; i~^relro; i~^static; il
EXPECT=<<EOF
intrp    /lib64/ld-linux-x86-64.so.2
nx       true
pic      true
relro    full
static   false
libc.so.6
EOF
RUN

# A static executable has no interpreter and nothing to seal.
NAME=static executable
FILE=tests/fixtures/syscalls_static_O2
CMDS=i~^intrp; i~^nx; i~^pic; i~^relro; i~^static; il
EXPECT=<<EOF
nx       true
pic      false
relro    no
static   true
EOF
RUN

# A shared object has a dynamic section and no interpreter.
NAME=shared object
FILE=tests/fixtures/arm_plt_lld_be8.so
CMDS=i~^intrp; i~^nx; i~^pic; i~^relro; i~^static; il
EXPECT=<<EOF
nx       true
pic      true
relro    partial
static   false
EOF
RUN

# No program header states a stack: nx is left unstated, though radare2 prints false.
NAME=relocatable object
FILE=tests/fixtures/x86_64_common_code.o
CMDS=i~^intrp; i~^nx; i~^pic; i~^relro; i~^static
EXPECT=<<EOF
pic      false
relro    no
static   true
EOF
RUN

# Mach-O states none of it in these terms.
NAME=mach-o
FILE=tests/fixtures/manual_limits_O0
CMDS=i~^intrp; i~^nx; i~^pic; i~^relro; i~^static; il
EXPECT=<<EOF
/usr/lib/libSystem.B.dylib
EOF
RUN

# D577: an ELF whose section table `object` refuses opens from its header and program headers,
# states the refusal and infers nothing a section header would state.
NAME=a section table past the file's end
FILE=tests/fixtures/crackme_shoff_past_end
CMDS=i~refused; iS; afl
EXPECT=<<EOF
sections refused: Invalid ELF section header offset/size/alignment
nth paddr        size vaddr       vsize perm flags type        name
-------------------------------------------------------------------
0x00400530    1     24 fcn.00400530
0x00400578    1      6 fcn.00400578
0x004005c0    2     42 entry0
0x004005ec    3     23 fcn.004005ec
0x00400610    6    100 fcn.00400610
0x00400680    4     34 fcn.00400680
0x004007d0    4     54 fcn.004007d0
0x00400808    1     14 fcn.00400808
EOF
RUN

NAME=a section header entry size that is not the format's
FILE=tests/fixtures/crackme_shentsize
CMDS=i~refused; ie
EXPECT=<<EOF
sections refused: Invalid ELF section header entry size
paddr      vaddr      phaddr     vhaddr     type
------------------------------------------------
0x000005c0 0x004005c0 0x00000018 0x00400018 program
EOF
RUN

