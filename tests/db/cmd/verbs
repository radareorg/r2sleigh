# D575: verbs radare2 6.2.4 spells that r2s lacked: `aaa`, `izj`, the seek history `s-` and `s+`,
# a letter's group help, and an unknown verb's nearest verb (`ij` is crates/r2s/tests/verbs.rs).

NAME=aaa is aa
FILE=tests/coverage/pinned/hashes_gcc_x64_O2
CMDS=aaa; afl~fnv1a
EXPECT=<<EOF
0x00401330    5     51 sym.fnv1a32
0x00401370    4     52 sym.fnv1a64
EOF
RUN

NAME=an unknown verb names its nearest verb
FILE=tests/coverage/pinned/hashes_gcc_x64_O2
CMDS=aaaa
EXPECT_ERR=<<EOF
r2s: unknown command 'aaaa'; did you mean aaa
EOF
EXPECT=<<EOF
EOF
RUN

