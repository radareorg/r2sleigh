# Debug
*.log

# Whole-binary coverage sweep artifacts (binaries, dumps, measured report)
tests/coverage/artifacts/

# Benchmark run output. Only tests/decbench/baseline.json is a record; the
# artifacts a run leaves behind are regenerated every time and differ per
# machine, so tracking them made every worktree's merge collide on a file
# nobody reads.
tests/decbench/artifacts/

# Equivalence gate output: builds, renderings, records. Only
# tests/equiv/baseline.json is a record, and only once the integrator blesses it.
tests/equiv/artifacts/
__pycache__/

.claude/settings.local.json
