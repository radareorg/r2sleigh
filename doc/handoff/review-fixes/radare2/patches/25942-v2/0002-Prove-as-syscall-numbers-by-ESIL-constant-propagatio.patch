+			syscall_run_reset (&run); // a run never spans two instruction sets
+		}
+		if (syscall_op_is_swi (&op, ret) && !run.delay_left && (!cands || syscall_cand_within (cands, &ci, at, at + len))) {
+			keep_going = syscall_hit (ctx, &op, ret, syscall_run_value (ctx, &run));
+		}
+		syscall_run_step (&run, &op, ret);
+		r_anal_op_fini (&op);
+		at += len;
+	}
+	free (buf);
+	return keep_going;
+}
+
+static int syscall_cand_hit(RSearchKeyword *kw, void *user, ut64 where) {
+	SyscallCand *cand = RVecSyscallCand_emplace_back ((RVecSyscallCand *)user);
+	if (!cand) {
+		return 0;
+	}
+	cand->addr = where;
+	cand->len = kw->keyword_length;
+	return 1;
+}
+
+static int syscall_cand_cmp(const SyscallCand *a, const SyscallCand *b) {
+	if (a->addr != b->addr) {
+		return (a->addr > b->addr) - (a->addr < b->addr);
+	}
+	return a->len - b->len;
+}
+
+// One masked scan with the encodings the arch plugin declares. Which of them an instruction may
+// start with at a hit is decided per hit, by the instruction set there.
+static bool syscall_candidates(SyscallSearchCtx *ctx, RSearch *search, ut64 from, ut64 to, RVecSyscallCand *cands) {
+	RCore *core = ctx->core;
+	const int bsize = R_MAX (4096, core->blocksize);
+	ut8 *buf = malloc (bsize);
+	bool ok = buf != NULL;
+	ut64 at;
+	r_search_set_callback (search, syscall_cand_hit, cands);
+	r_search_begin (search);
+	for (at = from; ok && at < to; at += bsize) {
+		const int len = (int)R_MIN ((ut64)bsize, to - at);
+		if (r_cons_is_breaked (core->cons)) {
+			ok = false;
+		} else if (r_io_read_at (core->io, at, buf, len)) {
+			ok = r_search_update (search, at, buf, len) != -1;
+		}
+	}
+	free (buf);
+	RVecSyscallCand_sort (cands, syscall_cand_cmp);
+	RVecSyscallCand_uniq (cands, syscall_cand_cmp);
+	return ok;
+}
+
+static RSearch *syscall_search_new(RCore *core) {
+	RList *kws = r_anal_syscalls (core->anal);
+	RSearch *search = NULL;
+	if (kws && !r_list_empty (kws) && (search = r_search_new (R_SEARCH_KEYWORD))) {
+		RListIter *iter;
+		RSearchKeyword *kw;
+		search->align = core->search->align;
+		search->overlap = true;
+		search->contiguous = true;
+		r_list_foreach (kws, iter, kw) {
+			r_search_kw_add (search, kw);
+		}
+		kws->free = NULL; // owned by the search now
+	}
+	r_list_free (kws);
+	return search;
+}
+
+// A candidate is kept when, in the instruction set at its address, an instruction may start there
+// and it decodes as a trap of exactly the matched encoding
+static bool syscall_search_cand(SyscallSearchCtx *ctx, ut64 from, const SyscallCand *cand, RVecSyscallCand *sweep) {
+	RCore *core = ctx->core;
+	SyscallIsa isa;
+	syscall_isa_at (ctx, cand->addr, &isa);
+	if (cand->addr % isa.align) {
+		return true;
+	}
+	if (isa.maxop != isa.unit && isa.maxop != 2 * isa.unit) {
+		// boundaries cannot be recovered backwards: left to the linear sweep
+		SyscallCand *c = RVecSyscallCand_emplace_back (sweep);
+		if (c) {
+			*c = *cand;
+		}
+		return true;
+	}
+	ut8 buf[32];
+	RAnalOp op = {0};
+	r_io_read_at (core->io, cand->addr, buf, sizeof (buf));
+	const int ret = r_anal_op (core->anal, &op, cand->addr, buf, sizeof (buf), R_ARCH_OP_MASK_VAL);
+	bool keep_going = true;
+	if (syscall_op_is_swi (&op, ret) && ret == cand->len) {
+		RAnalBlock *bb = syscall_fcn_block (core, cand->addr);
+		if (!bb) {
+			keep_going = syscall_window_hit (ctx, &isa, from, &op, ret);
+		} else if (r_anal_block_op_starts_at (bb, cand->addr)) {
+			keep_going = syscall_fcn_hit (ctx, &op, ret);
+		}
+	}
+	r_anal_op_fini (&op);
+	return keep_going;
+}
+
+static bool syscall_search_range(SyscallSearchCtx *ctx, RSearch *search, ut64 from, ut64 to) {
+	if (from >= to) {
+		return true;
+	}
+	if (!search) {
+		return syscall_sweep (ctx, from, to, NULL);
+	}
+	RVecSyscallCand cands, sweep;
+	RVecSyscallCand_init (&cands);
+	RVecSyscallCand_init (&sweep);
+	bool keep_going = syscall_candidates (ctx, search, from, to, &cands);
+	SyscallCand *c;
+	R_VEC_FOREACH (&cands, c) {
+		if (!keep_going) {
+			break;
+		}
+		keep_going = syscall_search_cand (ctx, from, c, &sweep) && !r_cons_is_breaked (ctx->core->cons);
+	}
+	if (keep_going && !RVecSyscallCand_empty (&sweep)) {
+		keep_going = syscall_sweep (ctx, from, to, &sweep);
+	}
+	RVecSyscallCand_fini (&cands);
+	RVecSyscallCand_fini (&sweep);
+	return keep_going;
+}
+
+static int syscall_range_cmp(const RInterval *a, const RInterval *b) {
+	return (a->addr > b->addr) - (a->addr < b->addr);
+}
+
+// An io map is a coarse statement of code: data sections such as .rel.dyn share the r-x segment.
+// Within a map search the executable sections of the binary the map belongs to; search the map as it
+// is when that binary states none (raw files, stripped section headers) or no binary owns the map,
+// while debugging, or when search.in names an explicit region (raw, block, flag, range, bin.section...).
+static void syscall_ranges(RCore *core, RSearchParameters *param, RIOMap *bound, RVecSyscallRange *out) {
+	const ut64 from = r_io_map_begin (bound);
+	const ut64 to = r_io_map_end (bound);
+	const bool maps = r_str_startswith (param->mode, "io.map") && !r_config_get_b (core->config, "cfg.debug");
+	RIOMap *map = maps? r_io_map_get_at (core->io, from): NULL;
+	RBinFile *bf = map? r_bin_file_find_by_fd (core->bin, map->fd): NULL;
+	RBinObject *obj = bf? bf->bo: NULL;
+	bool code = false;
+	RBinSection *s;
+	if (obj) {
+		R_VEC_FOREACH (&obj->sections_vec, s) {
+			if (s->is_segment || !(s->perm & R_PERM_X)) {
+				continue;
+			}
+			code = true;
+			const ut64 addr = core->io->va? r_bin_file_get_vaddr (bf, s->paddr, s->vaddr): s->paddr;
+			const ut64 size = core->io->va? s->vsize: s->size;
+			const ut64 lo = R_MAX (from, addr);
+			const ut64 hi = R_MIN (to, (addr + size < addr)? UT64_MAX: addr + size);
+			RInterval *itv = (lo < hi)? RVecSyscallRange_emplace_back (out): NULL;
+			if (itv) {
+				*itv = (RInterval){ lo, hi - lo };
+			}
+		}
+	}
+	if (!code) {
+		RInterval *itv = RVecSyscallRange_emplace_back (out);
+		if (itv) {
+			*itv = (RInterval){ from, to - from };
+		}
 		return;
 	}
-	RVecSyscallFunctionCache_init (&fcn_cache);
+	RVecSyscallRange_sort (out, syscall_range_cmp);
+	// overlapping sections would report their hits twice
+	size_t i, n = 0;
+	const size_t count = RVecSyscallRange_length (out);
+	for (i = 0; i < count; i++) {
+		RInterval *cur = RVecSyscallRange_at (out, i);
+		RInterval *last = n? RVecSyscallRange_at (out, n - 1): NULL;
+		if (last && cur->addr <= r_itv_end (*last)) {
+			last->size = R_MAX (r_itv_end (*last), r_itv_end (*cur)) - last->addr;
+		} else {
+			*RVecSyscallRange_at (out, n++) = *cur;
+		}
+	}
+	while (RVecSyscallRange_length (out) > n) {
+		RVecSyscallRange_pop_back (out);
+	}
+}
 
